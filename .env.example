# Адрес сервиса «Факт». Задаётся при сборке/развёртывании (ТЗ 10.2).
# Пусто — интерфейс ходит на тот же origin, откуда отдан.
VITE_API_BASE_URL=

# Мок-слой для ручек из ТЗ 5.2, которых ещё нет на бэкенде
# (JSON-отчёт, фоновый режим, история, переопределение участия).
# true — работать на моках, false — только реальные ручки.
VITE_USE_MOCKS=true

# Клиентский таймаут расчёта в минутах. По ТЗ 7.1.1 — не меньше 15.
VITE_REPORT_TIMEOUT_MINUTES=20

# Только для локальной разработки: адрес бэкенда, на который vite проксирует /api и /health.
# VITE_DEV_API_PROXY=http://localhost:8000
