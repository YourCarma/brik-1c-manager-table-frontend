{
  "name": "fakt-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Веб-интерфейс сервиса управленческой таблицы «Факт» — ТПК БРИК",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --force",
    "check": "esbuild scripts/check-acceptance.ts --bundle --platform=node --format=esm --target=node20 --alias:@=./src --external:exceljs --external:jszip --define:import.meta.env.VITE_API_BASE_URL=\"''\" --define:import.meta.env.VITE_REPORT_TIMEOUT_MINUTES=\"'20'\" --outfile=node_modules/.tmp/check-acceptance.mjs && node node_modules/.tmp/check-acceptance.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
